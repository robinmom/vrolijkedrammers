{
  "expo": {
    "name": "De Vrolijke Drammers",
    "slug": "vrolijkedrammers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.vrolijkedrammers.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.vrolijkedrammers.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087BC1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      [
        "expo-calendar",
        {
          "calendarPermission": "De app zet activiteiten van De Vrolijke Drammers in je agenda als je daarom vraagt."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#ED0012",
          "defaultChannel": "program"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "De Vrolijke Drammers gebruikt de camera om QR-codes te scannen bij de ingang en de kassa.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "drammers",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appStoreUrl": null,
      "eas": {
        "projectId": "c47e4952-d3a2-45cc-9e0f-150472c11eeb"
      }
    },
    "owner": "robinmom"
  }
}
