{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app-dvd-api-dev.azurewebsites.net",
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app-dvd-api-dev.azurewebsites.net",
        "APP_VARIANT": "development"
      },
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "channel": "testflight"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6828389452"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6818789905"
      }
    }
  }
}
