{
  "openapi": "3.1.1",
  "info": {
    "title": "Drammers.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/app-config": {
      "get": {
        "tags": [
          "AppConfig"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/check": {
      "get": {
        "tags": [
          "AuthCheck"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/carnival-years/current": {
      "get": {
        "tags": [
          "CarnivalYears"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CarnivalYearResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarnivalYearResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarnivalYearResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppConfigResponse": {
        "required": [
          "minAppVersion",
          "recommendedAppVersion",
          "maintenance",
          "supportEmail",
          "features"
        ],
        "type": "object",
        "properties": {
          "minAppVersion": {
            "$ref": "#/components/schemas/MinAppVersion"
          },
          "recommendedAppVersion": {
            "type": "string"
          },
          "maintenance": {
            "$ref": "#/components/schemas/Maintenance"
          },
          "supportEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      },
      "CarnivalYearResponse": {
        "required": [
          "id",
          "name",
          "startDate",
          "endDate",
          "carnivalStartDate",
          "carnivalEndDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "carnivalStartDate": {
            "type": "string",
            "format": "date"
          },
          "carnivalEndDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Maintenance": {
        "required": [
          "enabled",
          "message"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MinAppVersion": {
        "required": [
          "ios",
          "android"
        ],
        "type": "object",
        "properties": {
          "ios": {
            "type": "string"
          },
          "android": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AppConfig"
    },
    {
      "name": "AuthCheck"
    },
    {
      "name": "CarnivalYears"
    }
  ]
}