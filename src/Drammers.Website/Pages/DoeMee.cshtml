@page "/doe-mee"
@model DoeMeeModel
@{
    var showApp = await Shell.ShowAppAsync();
    var showTickets = await Shell.ShowTicketsAsync();
    var parts = new List<string> { "Lid worden", "meedoen aan de optocht" };
    if (showTickets) parts.Add("kaarten kopen");
    if (showApp) parts.Add("de app downloaden");
    var intro = string.Join(", ", parts.Take(parts.Count - 1)) + " of " + parts[^1] + ": alles regel je hier online.";
}
<partial name="_PageBand" model='new PageBand("Doe mee", intro, (null, "Doe mee"))' />
<div class="wrap content">
    <section class="join-band" aria-label="Doe mee">
        <partial name="_JoinTiles" />
    </section>
    @if (showApp)
    {
        <section class="card cta-card" id="app" aria-labelledby="app-kop">
            <h2 id="app-kop">De app van De Vrolijke Drammers</h2>
            <p>Programma, nieuws, pushmeldingen en je QR voor carnaval. Voor leden, ouders van jeugdleden en iedereen die Loils carnaval wil volgen.</p>
            <p class="muted">De app staat binnenkort in de App Store en Google Play.</p>
        </section>
    }
</div>
