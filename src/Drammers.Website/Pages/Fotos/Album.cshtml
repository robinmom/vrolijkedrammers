@page "/fotos/{id:guid}"
@model Drammers.Website.Pages.Fotos.AlbumModel
@if (Model.IsNotFound)
{
    return;
}
@{
    var a = Model.Album;
    var band = new PageBand(a.Title, a.Description ?? (a.Date is { } d ? Nl.Date(d) : null), ("/fotos", "Foto's"), (null, a.Title));
}
<partial name="_PageBand" model="band" />
<div class="wrap content">
    <p class="muted">@a.PhotoCount foto's. Tik op een foto om hem groot te bekijken en veeg naar de volgende.</p>
    <partial name="_PhotoGallery" model="new PhotoGallery(a.Title, Model.Photos)" />
    <p><a class="button outline" href="/fotos">← Alle foto's</a></p>
</div>
