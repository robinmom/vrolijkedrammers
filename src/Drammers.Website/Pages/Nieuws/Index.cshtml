@page "/nieuws"
@model Drammers.Website.Pages.Nieuws.IndexModel
<partial name="_PageBand" model='new PageBand("Nieuws", "Het laatste nieuws van De Vrolijke Drammers.", (null, "Nieuws"))' />
<div class="wrap content">
    @if (Model.Items.Count == 0)
    {
        <p class="muted">Nog geen nieuws.</p>
    }
    <div class="news-index">
        @foreach (var n in Model.Items)
        {
            <a class="card news-feature" href="/nieuws/@n.Slug">
                @if (n.ImageUrl is not null)
                {
                    <img src="@n.ImageUrl" alt="" loading="lazy" width="1600" height="900">
                }
                <div class="news-text">
                    <span class="news-date">@Nl.Date(n.PublishedAt)</span>
                    <h3>@n.Title</h3>
                    @if (n.Summary is not null)
                    {
                        <p class="muted">@n.Summary</p>
                    }
                </div>
            </a>
        }
    </div>
    @if (Model.Pages > 1)
    {
        <nav class="pager" aria-label="Pagina's">
            @if (Model.Current > 1)
            {
                <a class="button outline" href="/nieuws?pagina=@(Model.Current - 1)">← Nieuwer</a>
            }
            @if (Model.Current < Model.Pages)
            {
                <a class="button outline" href="/nieuws?pagina=@(Model.Current + 1)">Ouder →</a>
            }
        </nav>
    }
</div>
