@page "/optocht"
@model OptochtModel
@{
    var p = Model.Parade;
    var title = p?.Name ?? "Optocht";
    var lead = p is null
        ? "De kleurrijke stoet met praalwagens, loopgroepen en muziek door Loil."
        : $"{p.Date.ToString("dddd d MMMM yyyy", Nl.Culture)} trekt de kleurrijke stoet met praalwagens, loopgroepen en muziek door Loil.";
    lead = char.ToUpper(lead[0], Nl.Culture) + lead[1..];
    var band = new PageBand(title, lead, (null, "Optocht"));
}
<partial name="_PageBand" model="band" />
<div class="wrap content">
    @if (Model.Results is not null)
    {
        <div class="card cta-card results-cta">
            <h2 class="h3">Uitslag @Model.Results</h2>
            <p>Bekijk alle prijswinnaars per categorie.</p>
            <p><a class="button" href="/optocht/uitslag">Naar de uitslag</a></p>
        </div>
    }
    <div class="grid-3 optocht-cards">
        <div class="card cta-card">
            <h2 class="h3">Inschrijven</h2>
            @if (p?.RegistrationOpen == true)
            {
                <span><span class="badge green">Open</span></span>
            }
            else if (p is not null && p.RegistrationOpensAt > DateTime.UtcNow)
            {
                <span><span class="badge">Vanaf @Nl.Date(p.RegistrationOpensAt)</span></span>
            }
            else
            {
                <span><span class="badge">Gesloten</span></span>
            }
            <p>
                @if (p is not null)
                {
                    @:Inschrijven kan van @Nl.Date(p.RegistrationOpensAt) tot en met @Nl.Date(p.RegistrationClosesAt). Je krijgt direct een opgavenummer.
                }
                else
                {
                    @:De inschrijving voor de volgende optocht is nog niet geopend.
                }
            </p>
            @if (p?.RegistrationOpen == true)
            {
                <p class="card-actions"><a class="button" href="/optocht-inschrijven/">Schrijf je in</a></p>
            }
        </div>
        <div class="card cta-card">
            <h2 class="h3">Mijn inschrijving</h2>
            <p>Log in om te zien hoe het met jullie inschrijving staat, of gebruik de link in je bevestigingsmail. In de app staat hij onder Optocht.</p>
            <p class="card-actions"><a class="button outline" href="/optocht-inschrijven/">Mijn inschrijving</a></p>
        </div>
        <div class="card cta-card">
            <h2 class="h3">Aanrijtijden</h2>
            @if (p?.ArrivalTimesPublished != true)
            {
                <span><span class="badge">Nog niet bekend</span></span>
            }
            <p>Hier staan de aanrijtijden en opstelplaatsen per startnummer zodra de optocht is ingedeeld.</p>
            @if (p?.ArrivalTimesPublished == true)
            {
                <p class="card-actions"><a class="button outline" href="/aanrijtijden/">Aanrijtijden</a></p>
            }
        </div>
    </div>
    <div class="two-col">
        <section class="prose" aria-labelledby="info-kop">
            <h2 id="info-kop">Praktische informatie</h2>
            @if (p is not null)
            {
                <p><strong>Start:</strong> @p.StartTime.ToString("HH:mm", Nl.Culture) uur@(p.StartLocation is null ? "" : $", {p.StartLocation}")</p>
                @if (p.RouteDescription is not null)
                {
                    <p><strong>Route:</strong> @p.RouteDescription</p>
                }
                @Html.Raw(p.InfoHtml)
            }
            @if (Model.Extra is not null)
            {
                @Html.Raw(Model.Extra.BodyHtml)
            }
        </section>
        <aside class="card downloads" aria-labelledby="vragen-kop">
            <h2 id="vragen-kop" class="h3">Vragen over de optocht?</h2>
            <p class="muted">Mail de optochtcommissie:</p>
            <p><a href="mailto:optocht@vrolijkedrammers.nl">optocht@vrolijkedrammers.nl</a></p>
        </aside>
    </div>
</div>
